<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eduadmin.Mapper.RoleMapper">

    <!--根据ID更新角色基本信息-->
    <!--set标签：会自动生成set关键字；会自动的删除掉更新字段后多余的,-->
    <update id="update">
        update role
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </set>
        where id = #{id}
    </update>

    <!--条件查询-->
    <select id="list" resultType="eduadmin.pojo.Role">
        select id, name, code, remark, create_time, update_time
        from role
        <where>
            <if test="name != null and name != ''">
                name like concat('%',#{name},'%')
            </if>
            <if test="code != null and code != ''">
                and code like concat('%',#{code},'%')
            </if>
            <if test="begin != null and end != null">
                and create_time between #{begin} and #{end}
            </if>
        </where>
        order by update_time desc
    </select>

    <!--查询回显-->
    <select id="getById" resultType="eduadmin.pojo.Role">
        select id, name, code, remark, create_time, update_time
        from role
        where id = #{id}
    </select>

    <!--查询指定角色ID集合对应的角色编码（删除前的保护性校验用）-->
    <select id="selectCodesByIds" resultType="java.lang.String">
        select code
        from role
        where id in
        <foreach collection="ids" separator="," item="id" open="(" close=")">
            #{id}
        </foreach>
    </select>

    <!--批量删除角色-->
    <delete id="del">
        delete from role
        where id in
        <foreach collection="ids" separator="," item="id" open="(" close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
