<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eduadmin.Mapper.EmpRoleMapper">

    <!--批量插入员工角色关联-->
    <!--为什么用 foreach 拼一条 instead of 在 Service 里循环调用 insert：
        10 个角色就是 10 次数据库往返，拼成一条 SQL 只往返 1 次。
        代价是语句变长，在授权这种低频操作上完全值得-->
    <insert id="insertBatch">
        insert into emp_role(emp_id, role_id) values
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{empId}, #{roleId})
        </foreach>
    </insert>

    <!--按员工ID批量删除关联-->
    <!--员工批量删除时调用。不做这一步，emp_role 里会留下指向已删员工的孤儿行，
        将来新增员工复用了同一个自增ID，这个人会莫名其妙继承前任的角色(很经典的脏数据事故)-->
    <delete id="deleteByEmpIds">
        delete from emp_role
        where emp_id in
        <foreach collection="empIds" separator="," item="empId" open="(" close=")">
            #{empId}
        </foreach>
    </delete>

    <!--按角色ID批量删除关联-->
    <!--角色批量删除时调用。同一张关联表服务两个方向的删除，
        哪边删了都要清干净，否则另一次鉴权时就会读到已经不存在的角色/员工ID-->
    <delete id="deleteByRoleIds">
        delete from emp_role
        where role_id in
        <foreach collection="roleIds" separator="," item="roleId" open="(" close=")">
            #{roleId}
        </foreach>
    </delete>

</mapper>
