<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eduadmin.Mapper.PermissionMapper">

    <!--根据ID更新权限点基本信息-->
    <!--这里 note 一个坑：type / sort / parentId 是 Integer，不能写 != '' 去判空，
         OGNL 拿数字和空字符串比较会出问题，只判 != null 即可-->
    <update id="update">
        update permission
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="type != null">type = #{type},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </set>
        where id = #{id}
    </update>

    <!--条件查询-->
    <select id="list" resultType="eduadmin.pojo.Permission">
        select id, name, code, type, parent_id, sort, remark, create_time, update_time
        from permission
        <where>
            <if test="name != null and name != ''">
                name like concat('%',#{name},'%')
            </if>
            <if test="code != null and code != ''">
                and code like concat('%',#{code},'%')
            </if>
            <if test="type != null">
                and type = #{type}
            </if>
            <if test="begin != null and end != null">
                and create_time between #{begin} and #{end}
            </if>
        </where>
        order by sort, id
    </select>

    <!--查询回显-->
    <select id="getById" resultType="eduadmin.pojo.Permission">
        select id, name, code, type, parent_id, sort, remark, create_time, update_time
        from permission
        where id = #{id}
    </select>

    <!--查询指定权限点ID集合对应的编码（删除前的保护性校验用）-->
    <select id="selectCodesByIds" resultType="java.lang.String">
        select code
        from permission
        where id in
        <foreach collection="ids" separator="," item="id" open="(" close=")">
            #{id}
        </foreach>
    </select>

    <!--批量删除权限点-->
    <delete id="del">
        delete from permission
        where id in
        <foreach collection="ids" separator="," item="id" open="(" close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
